# Copia este archivo como .env (en la raíz del proyecto o en backend/)

# Proveedor de visión: gemini (por defecto) | ollama | anthropic
PROVIDER=gemini

# Gemini — key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Respaldo: se usa UNA vez si el principal responde 503 (saturado). Vacío = sin respaldo.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Ollama local (sin key). Necesita un modelo con visión: ollama pull qwen2.5vl:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Anthropic (Claude)
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5-5

MAX_UPLOAD_MB=100
MAX_DURATION_S=180
FRAME_COUNT=5
FRAME_WIDTH=768
CAPTION_COUNT=6

# Solo si FFmpeg no está en el PATH (Windows, por ejemplo):
# FFMPEG_BIN=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_BIN=C:/ffmpeg/bin/ffprobe.exe
